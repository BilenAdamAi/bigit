{
	"name": "bigit",
	"version": "0.1.0",
	"description": "A VSCode-style interactive source control panel for your vault: stage/unstage, inline diff gutters, commit history, and branch management.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"git",
		"source-control"
	],
	"author": "bilen adam",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.10.2",
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@lezer/common": "^1.2.1",
		"@lezer/highlight": "^1.2.1",
		"@types/diff": "^5.2.1",
		"@types/node": "^22.5.4",
		"builtin-modules": "4.0.0",
		"esbuild": "0.24.0",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "5.6.2",
		"vitest": "^2.1.1"
	},
	"dependencies": {
		"diff": "^5.2.0",
		"simple-git": "^3.27.0"
	}
}
